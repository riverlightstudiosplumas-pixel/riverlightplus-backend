from datetime import datetime, timedelta
from typing import List
from .ad_models import AdCampaign


def reset_daily(campaigns: List[AdCampaign]) -> None:
    """
    Resets daily impression counters and viewer frequency maps.
    Should run once every 24 hours (e.g., via a cron job or FastAPI startup task).
    """
    for c in campaigns:
        c.today_impressions = 0
        c.viewer_frequency_map.clear()


def reset_monthly(campaigns: List[AdCampaign]) -> None:
    """
    Resets monthly impression counters.
    Should run on the 1st of each month.
    """
    for c in campaigns:
        c.impressions_served = 0
        c.active = True  # Reactivate campaigns that hit their cap


def pacing_score(campaign: AdCampaign) -> float:
    """
    Returns a pacing score that helps prevent early burn-out.
    Lower score = higher priority to serve.
    """

    if campaign.max_impressions == 0:
        return 1.0

    # Percent of monthly budget used
    monthly_ratio = campaign.impressions_served / campaign.max_impressions

    # Percent of daily cap used
    daily_ratio = (
        campaign.today_impressions / campaign.daily_cap
        if campaign.daily_cap > 0 else 1.0
    )

    # Combine ratios to determine pacing
    return (monthly_ratio * 0.6) + (daily_ratio * 0.4)


def sort_by_pacing(campaigns: List[AdCampaign]) -> List[AdCampaign]:
    """
    Sorts campaigns so under-delivering campaigns get priority.
    """
    return sorted(campaigns, key=pacing_score)
